{
  "schemaVersion": 1,
  "id": "jon.modem",
  "name": "Modem Manager",
  "version": "1.1.1",
  "author": "Jon Knight",
  "license": "MIT",
  "description": "Cellular radio, connection controls, signal and traffic monitoring for ModemManager.",
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "Panel.qml"
  },
  "barWidget": {
    "displayName": "Modem Manager",
    "description": "Modem power, connection, signal, traffic and diagnostics.",
    "category": "Network",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "refreshIntervalSec": 10
    },
    "schema": [
      {
        "key": "refreshIntervalSec",
        "type": "integer",
        "label": "Background refresh (seconds)",
        "min": 5,
        "max": 60,
        "step": 5,
        "defaultValue": 10
      }
    ]
  }
}
